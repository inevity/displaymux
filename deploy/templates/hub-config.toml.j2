# Managed by Ansible — edits here will be overwritten on next playbook run.
# This host is the lan-mouse server and the fail-local input owner.

# configure release bind
release_bind = [ "KeyA", "KeyS", "KeyD", "KeyF" ]

# optional port (defaults to 4242)
port = {{ lan_mouse_port }}
emulation_display = "{{ lan_mouse_emulation_displays[inventory_hostname] }}"

[clipboard]
enabled = {{ lan_mouse_clipboard_enabled | lower }}
max_bytes = {{ lan_mouse_clipboard_max_bytes }}

[switch_controller]
url = "http://{{ hostvars[displaymux_controller_inventory_host].ansible_host }}:{{ daemon_port }}"
token = "{{ lookup('ansible.builtin.file', lan_mouse_controller_token_file) | trim }}"
local_host = "controller"
server_host = "controller"
http_timeout_ms = {{ lan_mouse_controller_http_timeout_ms }}
request_timeout_ms = {{ lan_mouse_controller_request_timeout_ms }}
poll_interval_ms = {{ lan_mouse_controller_poll_interval_ms }}
edge_double_tap_ms = {{ lan_mouse_edge_double_tap_ms }}
lease_ttl_ms = {{ lan_mouse_controller_lease_ttl_ms }}
renew_interval_ms = {{ lan_mouse_controller_renew_interval_ms }}

# list of authorized tls certificate fingerprints that
# are accepted for incoming traffic
[authorized_fingerprints]
{% for peer_role in ['left', 'right'] %}
"{{ displaymux_host_fingerprints[peer_role] }}" = "{{ displaymux_inventory_hosts[peer_role] }}"
{% endfor %}

{% for peer_role in ['left', 'right'] %}
[[clients]]
hostname = "{{ displaymux_inventory_hosts[peer_role] }}"
ips = [ "{{ hostvars[displaymux_inventory_hosts[peer_role]].ansible_host }}" ]
port = {{ lan_mouse_port }}
position = "{{ peer_role }}"
activate_on_startup = true
switch_target = "{{ peer_role }}"
{% endfor %}
