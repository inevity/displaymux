# Maintainer: CupricReki
# Maintainer: feschber
# Managed by Ansible — GTK stripped, pinned to {{ lan_mouse_release_tag }}.

pkgname=lan-mouse-git
_pkgname=lan-mouse
pkgver={{ lan_mouse_release_tag | regex_replace('^main-', '') }}
pkgrel=1
pkgdesc="Software KVM Switch / mouse & keyboard sharing software for Local Area Networks"
url="https://github.com/feschber/lan-mouse"
license=("GPL-3.0-only")
arch=(any)
provides=("$_pkgname=${pkgver/\.r*/}")
conflicts=("$_pkgname")
source=("$_pkgname"::"git+https://github.com/feschber/$_pkgname.git#tag={{ lan_mouse_release_tag }}")
sha256sums=('SKIP')
depends=(libx11 libxtst glibc gcc-libs)
makedepends=(git cargo rust cmake pkgconf)
options=('!lto')

pkgver() {
  cd "$_pkgname"
  git describe --abbrev=10 --long --tags --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin lan-mouse \
    --no-default-features \
    -F layer_shell_capture,libei_capture,x11_capture,wlroots_emulation,libei_emulation,x11_emulation,rdp_emulation
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --no-default-features -F layer_shell_capture,libei_capture,x11_capture,wlroots_emulation,libei_emulation,x11_emulation,rdp_emulation
}

package() {
  cd "$_pkgname"

  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$_pkgname"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$_pkgname" LICENSE
}
